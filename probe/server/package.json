{
  "name": "gaohe-probe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.workers.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply gaohe-probe --local",
    "db:migrate:remote": "wrangler d1 migrations apply gaohe-probe --remote",
    "smoke": "bash scripts/smoke-local.sh"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
